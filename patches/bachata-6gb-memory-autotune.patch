 namespace Core {
 
+u64 GetTotalGuestMemoryBytes() {
+    // Small headroom: the backing file is lazily committed, only the pages the
+    // game actually touches cost RAM, so we can size it close to physical RAM.
+    constexpr u64 mobile_headroom = 512_MB;
+    // Never drop below what typical titles need for their direct+flexible maps,
+    // otherwise the direct memory allocator fails before the game boots.
+    constexpr u64 min_budget = 4_GB;
+    // The maximum budget matches the devkit default on desktop hosts.
+    constexpr u64 max_budget = ORBIS_KERNEL_TOTAL_MEM_DEV_PRO + ORBIS_KERNEL_FLEXIBLE_MEMORY_SIZE;
+
+    u64 budget = max_budget;
+#ifndef _WIN32
+    const long pages = sysconf(_SC_PHYS_PAGES);
+    const long page_size = sysconf(_SC_PAGE_SIZE);
+    if (pages > 0 && page_size > 0) {
+        const u64 host_ram = static_cast<u64>(pages) * static_cast<u64>(page_size);
+        const u64 usable = host_ram > mobile_headroom ? host_ram - mobile_headroom : host_ram / 2;
+        budget = std::clamp(usable, min_budget, max_budget);
+    }
+#endif
+    budget += EmulatorSettings.GetExtraDmemInMBytes() * 1_MB;
+    return budget;
+}
