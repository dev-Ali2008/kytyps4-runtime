+// --- Async-signal-safe crash reporting -------------------------------------
+// The normal logging path (PrintfFtrace) calls fflush(), which takes the
+// stdio FILE lock and is NOT safe inside a signal handler: if the crashing
+// thread (or any other) held that lock, the handler would deadlock silently
+// and the crash would stay invisible. These helpers write straight to the log
+// fd with raw write() only (no stdio locks, no malloc, no fflush).
+extern FILE* ftrace;    // box64's log FILE* (default: stderr, see core.c)
+
+static void crash_write(const char* s, size_t len)
+{
+    if (!s || !len) return;
+    int fds[4];
+    int n = 0;
+    if (ftrace) {
+        int fd = fileno(ftrace);
+        if (fd >= 0) fds[n++] = fd;
+    }
+    if (n == 0 || (n && fds[0] != 2)) fds[n++] = 2;   // stderr as fallback
+    if (n == 1 || (n == 2 && fds[1] != 1)) fds[n++] = 1; // also stdout if not dup
+    for (int i = 0; i < n; ++i) {
+        int dup = 0;
+        for (int j = 0; j < i; ++j) if (fds[j] == fds[i]) { dup = 1; break; }
+        if (!dup) (void)!write(fds[i], s, len);
+    }
+}
+
+static void crash_printf(const char* fmt, ...)
+{
+    char buf[1024];
+    va_list args;
+    va_start(args, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, args);
+    va_end(args);
+    if (n < 0) return;
+    if ((size_t)n >= sizeof(buf)) n = sizeof(buf) - 1;
+    crash_write(buf, (size_t)n);
+}
+
+// Best-effort thread name, async-signal-safe via /proc (no malloc/locks).
+static void thread_comm(int tid, char* out, size_t sz)
+{
+    if (!out || !sz) return;
+    *out = 0;
+    char path[64];
+    int plen = snprintf(path, sizeof(path), "/proc/self/task/%d/comm", tid);
+    if (plen <= 0 || (size_t)plen >= sizeof(path)) return;
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) return;
+    ssize_t r = read(fd, out, sz - 1);
+    close(fd);
+    if (r > 0) {
+        out[r] = 0;
+        while (r > 0 && (out[r-1]=='\n' || out[r-1]=='\r' || out[r-1]==' ' || out[r-1]=='\t'))
+            out[--r] = 0;
+    }
+}
+
+// Reset the disposition for `sig` to the default and re-raise it on this
+// thread so the process dies with the canonical status (128+sig). Unlike
+// relying on the faulting instruction to re-fault, this always delivers.
+static void fatal_reset_and_raise(int32_t sig)
+{
+    int nsig = signal_from_x64(sig);
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = SIG_DFL;
+    sigaction(nsig, &sa, NULL);
+    (void)syscall(SYS_tgkill, getpid(), GetTID(), nsig);
+    raise(nsig);    // fallback if tgkill is intercepted
+}
