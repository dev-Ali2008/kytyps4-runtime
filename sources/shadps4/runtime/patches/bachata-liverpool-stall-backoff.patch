+constexpr u64 STALL_BACKOFF_ITERS = 10'000;
+constexpr std::chrono::microseconds STALL_BACKOFF_SLEEP{500};
+
+/// Reduces the GPU coroutine busy-spin on memory waits (MEM_SEMAPHORE,
+/// WAIT_REG_MEM, ...) that have no chance to progress yet. While the
+/// semaphore/label is pending and this is the only pending submit, the command
+/// processor has nothing else to run, so sleep the OS thread briefly instead of
+/// bouncing the coroutine at ~100% CPU. When other submits exist we keep
+/// yielding so they can make progress.
+static void StallBackoff(u64 iterations, const std::atomic<u32>& num_submits) {
+    if (iterations < STALL_BACKOFF_ITERS) {
+        return;
+    }
+    if (num_submits.load(std::memory_order_relaxed) != 1) {
+        return;
+    }
+    std::this_thread::sleep_for(STALL_BACKOFF_SLEEP);
+}
