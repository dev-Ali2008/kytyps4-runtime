#!/bin/sh
# CI=ON placeholder for box64 build scripts.
# Generated artifacts (dynacache_hashes.h, git_head.h) are pre-committed in the
# source tree, so a real python interpreter is never required.
#
# Ninja still runs this once: dynacache_hashes.h is marked GENERATED and is
# included by dynacache.c, so the custom command is a file-level dependency.
# Succeed and keep the --output file fresh (restat=1) so the edge stays clean.
out=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --output) out="$2"; shift 2 ;;
        --output=*) out="${1#--output=}"; shift ;;
        *) shift ;;
    esac
done
if [ -n "$out" ]; then
    if [ ! -e "$out" ]; then
        printf '#ifndef _DYNACACHE_HASHES_H_\n#define _DYNACACHE_HASHES_H_\nstatic const uint64_t dynacache_hashes[] = { 0 };\n#define DYNACACHE_NUM_HASHES 1\n#endif\n' > "$out"
    else
        touch "$out" 2>/dev/null || : >> "$out"
    fi
fi
exit 0
