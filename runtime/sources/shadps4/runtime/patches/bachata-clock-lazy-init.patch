@@ -29,27 +30,38 @@
 namespace Libraries::Kernel {
 
 static u64 initial_ptc;
+static std::once_flag clock_init_flag;
 static std::unique_ptr<Common::NativeClock> clock;
 
+// The kernel clock is normally created in RegisterTime, but host-side subsystems
+// (SDL audio, controller, videoout, mouse) may call the time syscalls from their
+// own threads as soon as they start, racing ahead of HLE library init. A null
+// clock used to crash in GetTimeUs (SIGSEGV on [this+0x10]) on cold first boot.
+// Initialize lazily and thread-safely so every caller always gets a valid clock.
+static Common::NativeClock& GetClock() {
+    std::call_once(clock_init_flag, [] { clock = std::make_unique<Common::NativeClock>(); });
+    return *clock;
+}
+
 u64 PS4_SYSV_ABI sceKernelGetTscFrequency() {
-    return clock->GetTscFrequency();
+    return GetClock().GetTscFrequency();
 }
 
 u64 PS4_SYSV_ABI sceKernelGetProcessTime() {
     // TODO: this timer should support suspends, so initial ptc needs to be updated on wake up
-    return clock->GetTimeUS(initial_ptc);
+    return GetClock().GetTimeUS(initial_ptc);
 }
 
 u64 PS4_SYSV_ABI sceKernelGetProcessTimeCounter() {
-    return clock->GetUptime() - initial_ptc;
+    return GetClock().GetUptime() - initial_ptc;
 }
 
 u64 PS4_SYSV_ABI sceKernelGetProcessTimeCounterFrequency() {
-    return clock->GetTscFrequency();
+    return GetClock().GetTscFrequency();
 }
 
 u64 PS4_SYSV_ABI sceKernelReadTsc() {
-    return clock->GetUptime();
+    return GetClock().GetUptime();
